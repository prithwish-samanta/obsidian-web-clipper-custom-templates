{
  "schemaVersion": "0.1.0",
  "name": "Article",
  "behavior": "create",
  "noteContentFormat": "## Highlights\n{{highlights|map:item => item.text (item.timestamp)|join:\"\\n\\n\"}}\n\n## Full Page Content\n{{content}}",
  "properties": [
    {
      "name": "categories",
      "value": "[[Clippings]]",
      "type": "multitext"
    },
    {
      "name": "title",
      "value": "{{title}}",
      "type": "text"
    },
    {
      "name": "source",
      "value": "{{url}}",
      "type": "text"
    },
    {
      "name": "contentType",
      "value": "Article",
      "type": "text"
    },
    {
      "name": "author",
      "value": "{{author|split:\\\", \\\"|wikilink|join}}",
      "type": "multitext"
    },
    {
      "name": "published",
      "value": "{{published}}",
      "type": "date"
    },
    {
      "name": "created",
      "value": "{{date}}",
      "type": "date"
    },
    {
      "name": "description",
      "value": "{{description}}",
      "type": "text"
    }
  ],
  "triggers": [
    "http://",
    "https://"
  ],
  "noteNameFormat": "{{title}}",
  "path": "Clippings"
}